# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- LLM provider (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434      # default Ollama address
OLLAMA_MODEL=qwen3.5:9b                  # model name as shown by `ollama list`

# --- Mock API ---
API_BASE_URL=http://127.0.0.1:8000         # default; change only if running API elsewhere

# --- SQLite ---
DB_PATH=users.db                           # path to the SQLite database file
